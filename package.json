    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "98.css": "^0.1.21",
    "cytoscape": "^3.35.0",
    "d3-geo": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
